# Test the fail-closed, idempotent patch without external model sources.
set(root "${CMAKE_CURRENT_LIST_DIR}/../../app/src/main/cpp")
include("${root}/WhisperWindowPatch.cmake")
set(fixture "${CMAKE_CURRENT_BINARY_DIR}/mnx-whisper-window-fixture")
file(REMOVE_RECURSE "${fixture}")
file(MAKE_DIRECTORY "${fixture}/src")
set(needle "    if (params.language == nullptr || strlen(params.language) == 0 || strcmp(params.language, \"auto\") == 0 || params.detect_language) {")
file(WRITE "${fixture}/src/whisper.cpp" "void check() {\n${needle}\n}\n")
mnx_patch_whisper_window("${fixture}")
file(READ "${fixture}/src/whisper.cpp" once)
string(FIND "${once}" "state->exp_n_audio_ctx = params.audio_ctx;" inserted)
if(inserted EQUAL -1)
    message(FATAL_ERROR "Missing early audio-context assignment")
endif()
mnx_patch_whisper_window("${fixture}")
file(READ "${fixture}/src/whisper.cpp" twice)
if(NOT once STREQUAL twice)
    message(FATAL_ERROR "Whisper window patch is not idempotent")
endif()
file(REMOVE_RECURSE "${fixture}")
message(STATUS "Whisper early-window patch test PASS")
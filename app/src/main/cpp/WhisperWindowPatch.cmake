# The pinned upstream version sets audio_ctx after language detection, so the first
# automatic detection encodes 30 seconds despite a five-second application window.
function(mnx_patch_whisper_window source_directory)
    set(source "${source_directory}/src/whisper.cpp")
    file(READ "${source}" text)
    set(marker "// MNX: bound the first language-detection encoder to the live window.")
    string(FIND "${text}" "${marker}" already_patched)
    if(NOT already_patched EQUAL -1)
        return()
    endif()
    set(needle "    if (params.language == nullptr || strlen(params.language) == 0 || strcmp(params.language, \"auto\") == 0 || params.detect_language) {")
    string(FIND "${text}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Unsupported Whisper language-detection layout")
    endif()
    set(replacement "    ${marker}\n    if (params.audio_ctx < 0 || params.audio_ctx > ctx->model.hparams.n_audio_ctx) return -5;\n    state->exp_n_audio_ctx = params.audio_ctx;\n${needle}")
    string(REPLACE "${needle}" "${replacement}" text "${text}")
    file(WRITE "${source}" "${text}")
endfunction()
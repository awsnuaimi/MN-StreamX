function(mnx_patch_bergamot source)
    set(root "${source}/inference/marian-fork")
    if(ANDROID_ABI MATCHES "^(armeabi-v7a|arm64-v8a)$")
        set(path "${root}/CMakeLists.txt")
        file(READ "${path}" content)
        if(NOT content MATCHES "MNX_ANDROID_FLAGS_V1")
            string(REPLACE "add_compile_definitions(USE_SSE2)" "# Native ARM uses NEON" content "${content}")
            string(REPLACE "-march=\${BUILD_ARCH} \${INTRINSICS}" "" content "${content}")
            string(REPLACE "set(CMAKE_CXX_FLAGS                 \"" "set(CMAKE_CXX_FLAGS                 \"\${CMAKE_CXX_FLAGS} " content "${content}")
            string(REPLACE "set(CMAKE_C_FLAGS                 \"" "set(CMAKE_C_FLAGS                 \"\${CMAKE_C_FLAGS} " content "${content}")
            string(APPEND content "\n# MNX_ANDROID_FLAGS_V1\n")
            file(WRITE "${path}" "${content}")
        endif()
        set(path "${source}/inference/src/translator/CMakeLists.txt")
        file(READ "${path}" content)
        string(REPLACE "PUBLIC USE_SSE2 WASM_COMPATIBLE_SOURCE" "PUBLIC ARM FMA SSE WASM_COMPATIBLE_SOURCE" content "${content}")
        file(WRITE "${path}" "${content}")
        set(path "${root}/src/3rd_party/simd_utils/sse2neon.h")
        file(READ "${path}" content)
        string(REPLACE "__builtin_nontemporal_store(a, (float64x2_t *) p);" "__builtin_nontemporal_store(a, (__m128d *) p);" content "${content}")
        file(WRITE "${path}" "${content}")
        set(path "${root}/src/3rd_party/simd_utils/sse2neon_wrapper.h")
        file(READ "${path}" content)
        string(REPLACE "return _mm_set_epi64(a1, a0);" "return _mm_set_epi64x(a1, a0);" content "${content}")
        file(WRITE "${path}" "${content}")
    endif()
    set(path "${root}/src/common/binary.cpp")
    file(READ "${path}" content)
    if(NOT content MATCHES "MNX_METADATA_V1")
        set(needle "io::Item getItem(const std::string& fileName, const std::string& varName) {")
        string(FIND "${content}" "${needle}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Pinned metadata entry point changed")
        endif()
        string(REPLACE "${needle}" "${needle}\n  // MNX_METADATA_V1\n  if (varName == \"special:model.yml\") return mnxReadMetadata(fileName, varName);" content "${content}")
        string(PREPEND content "#include \"mnx_binary_metadata.h\"\n")
        file(WRITE "${path}" "${content}")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BergamotMetadata.h" "${root}/src/common/mnx_binary_metadata.h" COPYONLY)
    set(path "${root}/src/translator/beam_search.cpp")
    file(READ "${path}" content)
    if(NOT content MATCHES "MNX_CANCEL_V1")
        set(needle "  for (size_t t = 0; ; t++) {")
        string(FIND "${content}" "${needle}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Pinned decoder loop changed")
        endif()
        string(REPLACE "${needle}" "${needle}\n    mnx::checkTranslation(); // MNX_CANCEL_V1" content "${content}")
        string(PREPEND content "#include \"mnx_caption_cancel.h\"\n")
        file(WRITE "${path}" "${content}")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BergamotCancellation.h" "${root}/src/translator/mnx_caption_cancel.h" COPYONLY)
    set(path "${root}/src/CMakeLists.txt")
    file(READ "${path}" content)
    if(NOT content MATCHES "MNX_ARCHIVE_VERSION_V1")
        set(first "set(MARIAN_GIT_DIR ")
        set(last "add_dependencies(marian marian_version)")
        string(FIND "${content}" "${first}" begin)
        string(FIND "${content}" "${last}" end)
        if(begin LESS 0 OR end LESS begin)
            message(FATAL_ERROR "Pinned Marian version block changed")
        endif()
        string(LENGTH "${last}" last_length)
        math(EXPR size "${end} + ${last_length} - ${begin}")
        string(SUBSTRING "${content}" ${begin} ${size} old)
        set(new "# MNX_ARCHIVE_VERSION_V1\nfile(WRITE \"\${CMAKE_CURRENT_SOURCE_DIR}/common/git_revision.h\" \"#define GIT_REVISION \\\"8eada038fd45bbf6fa58a412b22f80c79887fabc\\\"\\n\")\nadd_custom_target(marian_version)\nadd_dependencies(marian marian_version)")
        string(REPLACE "${old}" "${new}" content "${content}")
        file(WRITE "${path}" "${content}")
    endif()
endfunction()
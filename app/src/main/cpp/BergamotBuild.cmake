include(${CMAKE_CURRENT_LIST_DIR}/BergamotDependencies.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BergamotSourcePatch.cmake)
if(MNX_NATIVE_SOURCES)
    set(mnx_bergamot "${CMAKE_CURRENT_BINARY_DIR}/mnx-bergamot")
    file(COPY "${bergamot_SOURCE_DIR}/" DESTINATION "${mnx_bergamot}")
else()
    set(mnx_bergamot "${bergamot_SOURCE_DIR}")
endif()
set(mnx_marian "${mnx_bergamot}/inference/marian-fork")
file(COPY "${ssplit_SOURCE_DIR}/" DESTINATION "${mnx_bergamot}/inference/3rd_party/ssplit-cpp")
foreach(pair sentencepiece intgemm ruy simd_utils)
    file(COPY "${${pair}_SOURCE_DIR}/" DESTINATION "${mnx_marian}/src/3rd_party/${pair}")
endforeach()
file(COPY "${cpuinfo_SOURCE_DIR}/" DESTINATION "${mnx_marian}/src/3rd_party/ruy/third_party/cpuinfo")
mnx_patch_bergamot("${mnx_bergamot}")
set(PCRE2_BUILD_PCRE2_8 ON CACHE BOOL "" FORCE)
foreach(flag PCRE2_BUILD_PCRE2_16 PCRE2_BUILD_PCRE2_32 PCRE2_BUILD_TESTS PCRE2_BUILD_PCRE2GREP PCRE2_SUPPORT_JIT)
    set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${pcre2_SOURCE_DIR}" "mnx-pcre2" EXCLUDE_FROM_ALL)
set(SSPLIT_USE_INTERNAL_PCRE2 OFF CACHE BOOL "" FORCE)
set(PCRE2_LIBRARIES pcre2-8-static CACHE STRING "" FORCE)
set(PCRE2_INCLUDE_DIRS "${pcre2_SOURCE_DIR}/src;${CMAKE_CURRENT_BINARY_DIR}/mnx-pcre2" CACHE STRING "" FORCE)
foreach(flag USE_WASM_COMPATIBLE_SOURCE USE_THREADS USE_RUY USE_RUY_SGEMM USE_STATIC_LIBS RUY_MINIMAL_BUILD)
    set(${flag} ON CACHE BOOL "" FORCE)
endforeach()
foreach(flag USE_ONNX_SGEMM USE_MKL COMPILE_WITHOUT_EXCEPTIONS COMPILE_UNIT_TESTS COMPILE_TESTS GIT_SUBMODULE SPM_ENABLE_SHARED SPM_ENABLE_TCMALLOC SPM_BUILD_TEST)
    set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
if(NOT ANDROID OR ANDROID_ABI STREQUAL "x86_64")
    set(BUILD_ARCH x86-64 CACHE STRING "" FORCE)
endif()
add_subdirectory("${mnx_bergamot}/inference" "mnx-bergamot-build" EXCLUDE_FROM_ALL)
set_property(TARGET marian PROPERTY JOB_POOL_COMPILE mnx_heavy)
set(SENTENCEPIECE_SOURCE_DIR "${mnx_marian}/src/3rd_party/sentencepiece")
if(ANDROID_ABI STREQUAL "armeabi-v7a")
    foreach(target marian bergamot-translator-source)
        target_include_directories(${target} PRIVATE "${simde_SOURCE_DIR}")
        target_compile_options(${target} PRIVATE "-include${CMAKE_CURRENT_LIST_DIR}/BergamotArmCompat.h")
    endforeach()
endif()
foreach(flag ZSTD_BUILD_PROGRAMS ZSTD_BUILD_TESTS ZSTD_BUILD_SHARED ZSTD_MULTITHREAD_SUPPORT)
    set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(ZSTD_BUILD_STATIC ON CACHE BOOL "" FORCE)
add_subdirectory("${zstd_SOURCE_DIR}/build/cmake" "mnx-zstd" EXCLUDE_FROM_ALL)